{
	"name": "gpui-agent-pi",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"license": "MIT",
	"description": "One-call Jev-driven GPUI goals with optional independent checks for pi",
	"repository": {
		"type": "git",
		"url": "https://github.com/stolinski/gpui-agent.git",
		"directory": "typescript"
	},
	"keywords": [
		"pi-package",
		"gpui"
	],
	"engines": {
		"node": ">=22.18"
	},
	"packageManager": "pnpm@11.1.3",
	"exports": {
		".": "./src/task.ts"
	},
	"pi": {
		"extensions": [
			"./src/extension.ts"
		]
	},
	"files": [
		"src",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"test": "node --test tests/*.test.ts",
		"check": "tsc --noEmit"
	},
	"dependencies": {
		"@typesafe-ai/sdk": "0.6.0"
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*"
	},
	"peerDependenciesMeta": {
		"@earendil-works/pi-ai": {
			"optional": true
		},
		"@earendil-works/pi-coding-agent": {
			"optional": true
		}
	},
	"devDependencies": {
		"@earendil-works/pi-ai": "0.85.1",
		"@earendil-works/pi-coding-agent": "0.85.1",
		"@types/node": "^24.0.0",
		"typescript": "~5.9.3"
	}
}
